/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onnepal",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * D1 Database Binding
	 * Run: wrangler d1 create onnepal-db
	 * Then add the database_id below
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "onnepal-db",
			"database_id": "e5470bfa-4bb2-46df-8783-3bc462a0b239"
		}
	],
	/**
	 * R2 Storage Binding for images
	 * Run: wrangler r2 bucket create onnepal-images
	 */
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "onnepal-images"
		}
	],
	/**
	 * Environment Variables
	 */
	"vars": {
		"UPVOTE_THRESHOLD_FOR_FEATURE": "10",
		"POSTS_PER_PAGE": "20"
	}
	/**
	 * Note: Use secrets for sensitive data like JWT_SECRET
	 * Run: wrangler secret put JWT_SECRET
	 */
}