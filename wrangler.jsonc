/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onnepal",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Routes for wildcard subdomain support
	 * Requires wildcard DNS: *.onnepal.com CNAME onnepal.com
	 */
	"routes": [
		{
			"pattern": "*.onnepal.com",
			"zone_name": "onnepal.com"
		},
		{
			"pattern": "onnepal.com/*",
			"zone_name": "onnepal.com"
		}
	],
	/**
	 * D1 Database Binding
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "onnepal-db",
			"database_id": "e5470bfa-4bb2-46df-8783-3bc462a0b239"
		}
	],
	/**
	 * R2 Storage Binding for images
	 */
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "onnepal-images"
		}
	]
	/**
	 * Note: Use secrets for sensitive data like JWT_SECRET
	 * Run: wrangler secret put JWT_SECRET
	 */
}
