# Local Development Environment Variables
# Copy this file to .dev.vars for local development

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Cloudflare Account ID (found in Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your-account-id

# D1 Database ID (from: wrangler d1 list)
CLOUDFLARE_DATABASE_ID=your-database-id

# D1 API Token (create at: https://dash.cloudflare.com/profile/api-tokens)
# Needs "D1" permissions
CLOUDFLARE_D1_TOKEN=your-d1-token
